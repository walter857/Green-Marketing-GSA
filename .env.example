# Green Marketing GSA - example environment file.
#
# PLACEHOLDERS ONLY. Never commit a real token, secret, or client ID.
# Copy to .env and fill in locally. .env is git-ignored.

# --- Google Ads (existing integration - unchanged by the Drive setup) ---
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-oauth-client-id
GOOGLE_ADS_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
GOOGLE_ADS_CUSTOMER_ID=1234567890

# --- Google Drive / Docs landing-page delivery ---
#
# These are OPTIONAL OVERRIDES. The Drive integration reads config/google-drive.yaml and
# does NOT load this .env file, so unrelated Google Ads values are never pulled into the
# Drive workflow. Set these as real environment variables only if the defaults are wrong
# for this machine.
#
# File PATHS only. The credential and token files themselves must live OUTSIDE the
# repository and must never be committed.
#
# GOOGLE_DRIVE_CREDENTIALS_FILE=D:\MG\secrets\green-marketing-drive-client.json
# GOOGLE_DRIVE_TOKEN_FILE=D:\MG\secrets\green-marketing-drive-token.json
#
# Non-secret Drive resource IDs. Preferred home is config/google-drive.yaml; these env
# vars override that file when set.
#
# GOOGLE_DRIVE_LANDING_PAGE_ROOT_FOLDER_ID=drive-folder-id-of-the-approved-root
# GOOGLE_DOC_LANDING_PAGE_TEMPLATE_ID=drive-file-id-of-the-copied-master-template
